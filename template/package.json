{
  "name": "<%= projectName %>",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "author": "Nova",
  "keywords": [
    "expo",
    "react",
    "react-native",
    "React native",
    "typescript",
    "nova",
    "sdk58",
    "redux",
    "redux-toolkit",
    "Rtk query",
    "i18n",
    "absolute path",
    "start files",
    "template"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "lint:fix": "eslint . --fix",
    "build:dev": "eas build --profile development",
    "build:staging": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "deploy:staging": "eas update --channel staging",
    "deploy:prod": "eas update --channel main",
    "g": "npx plop",
    "generate": "npx plop",
    "test:ci": "jest --ci",
    "test:coverage": "jest --ci --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|immer))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/plop-templates/",
      "<rootDir>/app/"
    ],
    "collectCoverageFrom": [
      "{apis,components,hooks,redux,utils}/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/__tests__/**"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/flash-list": "2.3.2",
    "dayjs": "^1.11.21",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-observe": "~58.0.19",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.88.1",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-otp-molecule": "^1.0.6",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "plop": "^4.0.5",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-worklets": "$react-native-worklets"
  },
  "private": true
}
